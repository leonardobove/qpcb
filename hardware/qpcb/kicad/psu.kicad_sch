	)
	(text "The input 24V is first converted to 8V using the TPS5450-Q1\nswitching voltage regulator. Then, it is further converted to\n6V using the LT3083 linear voltage regulator. 8V input\nvoltage is required to guarantee the minimum voltage\ndropout of the schottky diode and of the LT3083."
		(exclude_from_sim no)
		(at 80.772 136.398 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
