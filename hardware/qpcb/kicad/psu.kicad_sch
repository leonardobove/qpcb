	(text "The output resistor is needed to guarantee\nthe minimum 1mA load requirement with Vout=12V.\nThe resistor on SET pin was chosen to guarantee\n12V output voltage."
		(exclude_from_sim no)
		(at 327.914 112.776 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "15992d95-8363-43ad-bde7-184acc570160")
	)
	(text "5V regulation"
		(exclude_from_sim no)
		(at 481.076 233.172 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "331a4615-0b8e-4ec8-bbfc-a80004f48e46")
	)
	(text "The output resistor is needed to guarantee\nthe minimum 1mA load requirement with Vout=6V.\nThe resistor on SET pin was chosen to guarantee\n6V output voltage."
		(exclude_from_sim no)
		(at 181.864 102.616 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "35c59b42-3ccc-42c3-a8b0-5dda64185ab8")
	)
	(text "The input 24V is first converted to 14V using the TPS5450-Q1\nswitching voltage regulator. Then, it is further converted to\n12V using the LT3083 linear voltage regulator. 14V input\nvoltage is required to guarantee the minimum voltage\ndropout of the schottky diode and of the LT3083."
		(exclude_from_sim no)
		(at 319.278 139.954 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3ce7736a-7ebb-4b58-a937-39cdeeb75406")
	)
	(text "Power-good LEDs"
		(exclude_from_sim no)
		(at 38.608 250.444 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "40d56b40-5b0f-41de-a3db-4e2f22ba1eb6")
	)
	(text "External connections"
		(exclude_from_sim no)
		(at 321.31 399.542 0)
		(effects
			(font
				(size 1.905 1.905)
			)
		)
		(uuid "461b5062-718b-415c-8a8d-dc664ad68ad2")
	)
	(text "Test-points"
		(exclude_from_sim no)
		(at 197.358 248.412 0)
		(effects
