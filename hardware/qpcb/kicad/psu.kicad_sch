	(text "The input 7.5V is first converted to -3.3V\nusing the MC34063AD buck-boost converter.\nThen, it is regulated at -3.3V using the LT337\nlinear voltage regulator. 7.5V input voltage is\nrequired to guarantee the minimum voltage dropout."
		(exclude_from_sim no)
		(at 542.544 133.858 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "61948a36-7ce8-471a-9930-1b1c957fdbb0")
	)
	(text "The output resistor is needed to guarantee\nthe minimum 1mA load requirement with Vout=6V.\nThe resistor on SET pin was chosen to guarantee\n6V output voltage."
		(exclude_from_sim no)
		(at 84.074 102.616 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7bb51ccd-39ff-4139-a713-32b6c41d6251")
	)
